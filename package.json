{
  "name": "martgpt",
  "private": true,
  "version": "1.0.0",
  "description": "Smart AI Supermarket and Kirana POS Billing System",
  "author": "MartGPT",
  "main": "electron/main.cjs",
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "postinstall": "cd backend && npm install",
    "dev": "node scripts/dev.cjs",
    "dev:vite": "vite --host",
    "dev:all": "node scripts/dev.cjs",
    "server": "node backend/server.js",
    "build": "vite build",
    "start": "node backend/server.js",
    "lint": "oxlint",
    "preview": "vite preview",
    "tunnel": ".\\cloudflared.exe tunnel --url http://localhost:5173",
    "electron:start": "electron electron/main.cjs",
    "electron:dev": "node scripts/dev_electron.cjs",
    "electron:build": "npm run build && electron-builder --win"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "@types/jsbarcode": "^3.11.4",
    "@zxing/browser": "^0.2.1",
    "@zxing/library": "^0.23.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "firebase": "^12.19.0",
    "html5-qrcode": "^2.3.8",
    "jsbarcode": "^3.12.3",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.47.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.88.0",
    "react-is": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "react-to-print": "^3.3.0",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0",
    "tesseract.js": "^7.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "oxlint": "^1.81.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0"
  },
  "build": {
    "appId": "com.martgpt.pos",
    "productName": "MartGPT POS",
    "copyright": "Copyright © 2026 MartGPT",
    "npmRebuild": false,
    "nodeGypRebuild": false,
    "directories": {
      "output": "dist_electron"
    },
    "files": [
      "dist/**/*",
      "backend/**/*",
      "electron/**/*",
      "public/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "backend/data",
        "to": "backend/data",
        "filter": [
          "*.db"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "public/pwa-512x512.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MartGPT POS"
    }
  }
}
